{
  "manifest_version": 3,
  "name": "ReviewPost: Turn Reviews into Social Posts",
  "short_name": "ReviewPost",
  "version": "1.0.0",
  "description": "Turn Google & Trustpilot reviews into branded Instagram, Story and LinkedIn posts in one click. 21 designs that match your brand.",
  "permissions": ["contextMenus", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open ReviewPost",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.co.uk/*",
        "https://www.trustpilot.com/*",
        "https://uk.trustpilot.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    },
    {
      "matches": ["https://extensionpay.com/*"],
      "js": ["vendor/ExtPay.js"],
      "run_at": "document_start"
    }
  ]
}
